  "sources": [
    {
      "code": "DS-01",
      "name": "HR 员工与组织档案",
      "requiredFields": "员工唯一编号、主体、部门、入离职日期、计薪资格",
      "description": "已有 HRM 数据或经授权导入；按有效期取档案；唯一编号不重复"
    },
    {
      "code": "DS-02",
      "name": "考勤系统",
      "requiredFields": "员工编号、周期、班次、应出勤、实出勤、请假、缺勤、异常状态",
      "description": "HRM 统计接口或模板导入；明确截止时间；单位一致；异常可定位"
    },
    {
      "code": "DS-03",
      "name": "OA 加班 / 请假审批",
      "requiredFields": "单据编号、员工、起止时间、审批状态、认可时长、补休状态",
      "description": "审批接口或确认清单；仅纳入符合确认条件的单据；可去重"
    },
    {
      "code": "DS-04",
      "name": "工时制度与排班系统",
      "requiredFields": "员工制度类型、适用有效期、结算周期、排班、实际工时、差异",
      "description": "制度档案、排班 / 考勤接口或模板导入；标准 / 综合 / 不定时工时分别校验；与加班及考勤对账"
    },
    {
      "code": "DS-05",
      "name": "薪酬方案与员工薪资档案",
      "requiredFields": "方案版本、适用人员、薪资项、金额 / 单价、有效期",
      "description": "HRM 薪资配置或确认清单；核算取对应版本；变更留痕"
    },
    {
      "code": "DS-06",
      "name": "社保公积金政策与缴费台账",
      "requiredFields": "地区、项目、有效期、基数上下限、个人 / 单位比例、实际缴费额",
      "description": "业务维护、台账导入；标准有出处及确认人；历史版本可追溯"
    },
    {
      "code": "DS-07",
      "name": "税务及扣除资料",
      "requiredFields": "纳税主体、年度、本年累计应税收入、已扣税额、专项扣除",
      "description": "经授权申报资料或模板导入；明确累计起点、员工匹配与缺失处理"
    },
    {
      "code": "DS-08",
      "name": "业务需求征集",
      "requiredFields": "需求编号、模块、功能、字段、来源、负责人、优先级、状态、备注",
      "description": "评审人员录入；可版本化导出；正式确认附评审依据"
    },
    {
      "code": "DS-09",
      "name": "绩效考核与薪级标准",
      "requiredFields": "绩效周期、基数、系数、职级 / 薪档、岗位系数、补贴标准",
      "description": "薪级表及绩效确认结果；周期与生效版本明确；金额 / 系数含业务确认依据"
    },
    {
      "code": "DS-10",
      "name": "财务预算与成本数据",
      "requiredFields": "部门 / 成本中心 / 项目、营收、预算、编制人数、分摊比例",
      "description": "财务确认台账或接口；报表维度、期间与分摊比例一致；总额可对账"
    },
    {
      "code": "DS-11",
      "name": "员工自助与联系方式",
      "requiredFields": "员工编号、接收渠道、邮箱 / 手机、工资条可见字段、投递结果",
      "description": "已授权员工档案及消息服务；员工匹配、渠道授权、失败与重发规则明确"
    },
    {
      "code": "DS-12",
      "name": "银行代发与回盘",
      "requiredFields": "批次、员工、账户、应付金额、文件格式、回盘状态、失败原因",
      "description": "银行代发文件与回盘模板；数据范围和脱敏有授权；账户匹配、金额及回盘可对账"
    }
  ]
}
